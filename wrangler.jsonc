{
  "name": "llbuild-worker",
  "main": "build/worker/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "CASGATEWAY", "class_name": "CASGateway" },
      { "name": "CASSHARD", "class_name": "CASShardObject" }
    ]
  },
  "migrations": [
    { "tag": "v2", "new_sqlite_classes": ["CASGateway", "CASShardObject"] }
  ]
}
